# movie-data-sql-analysis
___________________________________________________________________________________________________________________________________________________________________
Basic Filtering 

# Find all movies released after 2015 with an IMDb rating greater than 7.5. Return the movie title, release year, and IMDb rating.

SELECT 
  Title,
  ReleaseYear,
  IMDbRating
FROM movie_data
WHERE ReleaseYear > 2015
  AND IMDbRating > 7.5
ORDER BY IMDbRating DESC;
___________________________________________________________________________________________________________________________________________________________________
Profitablity Analysis 

# Find the top 10 highest grossing movies globally released after 2010 where the budget was greater than 5 million USD and the IMDb rating was greater than 7.

SELECT 
  Title,
  Global_BoxOfficeUSD,
  BudgetUSD,
  (Global_BoxOfficeUSD - BudgetUSD) AS Profit
FROM movie_data
WHERE BudgetUSD > 5000000
  AND ReleaseYear > 2010
  AND IMDbRating > 7
ORDER BY Global_BoxOfficeUSD DESC
LIMIT 10;
___________________________________________________________________________________________________________________________________________________________________
Genre Analysis

# Top profitable Genre's

SELECT 
  Genre,
  AVG(Global_BoxOfficeUSD - BudgetUSD) AS Avg_Profit,
  COUNT(*) AS Movie_Count
FROM movie_data
GROUP BY Genre
HAVING COUNT(*) >= 5
ORDER BY Avg_Profit DESC
LIMIT 3;

# Advanced genre analysis

WITH genre_stats AS (
    SELECT 
        Genre,
        AVG(IMDbRating) AS Avg_Rating,
        SUM(Global_BoxOfficeUSD) AS Total_Revenue
    FROM movie_data
    GROUP BY Genre
)

SELECT
    Genre,
    Avg_Rating,
    Total_Revenue,
    RANK() OVER (ORDER BY Total_Revenue DESC) AS Revenue_Rank
FROM genre_stats
WHERE Avg_Rating > (
    SELECT AVG(IMDbRating)
    FROM movie_data
)

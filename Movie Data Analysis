Window Functions

# Assign a rank to movies based on Global_BoxOfficeUSD.

SELECT 
  Title,
  Global_BoxOfficeUSD,
  RANK() OVER (
    ORDER BY Global_BoxOfficeUSD DESC
  ) AS movie_rank
FROM movie_data;

# For each country, find the top 3 highest IMDb rated movies.

WITH ranked_movies AS (
  SELECT 
    Country,
    Title,
    IMDbRating,
    RANK() OVER (
      PARTITION BY Country 
      ORDER BY IMDbRating DESC
    ) AS movie_rank
  FROM movie_data
)

SELECT *
FROM ranked_movies
WHERE movie_rank <= 3;

# Find the second highest grossing movie in each genre.

WITH ranked_movies AS (
    SELECT 
        Genre,
        Title,
        Global_BoxOfficeUSD,
        ROW_NUMBER() OVER (
            PARTITION BY Genre 
            ORDER BY Global_BoxOfficeUSD DESC
        ) AS movie_rank
    FROM movie_data
)

SELECT 
    Genre,
    Title,
    Global_BoxOfficeUSD
FROM ranked_movies
WHERE movie_rank = 2;
AND Total_Revenue > 50000000;

Director Analysis

# Find the best directors in terms of ratings consistency. Only include directors who have directed at least 5 movies.

SELECT 
  Director,
  COUNT(*) AS Movie_Count,
  AVG(IMDbRating) AS Avg_Rating,
  MAX(IMDbRating) AS Max_Rating,
  MIN(IMDbRating) AS Min_Rating
FROM movie_data
GROUP BY Director
HAVING COUNT(*) >= 5
ORDER BY Avg_Rating DESC;

# Find directors whose movies are the most consistent in ratings. Only include directors with at least 5 movies. 

SELECT 
  Director,
  COUNT(*) AS Movie_Count,
  AVG(IMDbRating) AS Avg_Rating,
  MAX(IMDbRating) AS Max_Rating,
  MIN(IMDbRating) AS Min_Rating,
  (MAX(IMDbRating) - MIN(IMDbRating)) AS Consistency
FROM movie_data
GROUP BY Director
HAVING COUNT(*) >= 5
ORDER BY Consistency ASC;
